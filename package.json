{
  "name": "worktrack",
  "productName": "WorkTrack",
  "version": "0.0.0",
  "description": "Cross-platform desktop time tracker for hourly work: tracks active time, idle detection and periodic screenshots, synced to a REST API.",
  "main": "src/main.js",
  "author": "Amber Ghulam",
  "scripts": {
    "clean": "rimraf dist",
    "start": "cross-env NODE_ENV=development electron .",
    "uat": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.amberghulam.worktrack",
   
    "asar": true,
    "icon": "desktopIcon.png",
    "win": {
      "target": ["portable", "msi"]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "node-global-key-listener": "^0.3.0",
    "sharp": "^0.33.5",
    "node-fetch": "^3.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^25.1.8"
  }
}